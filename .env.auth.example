# Copiez ce fichier vers auth_gateway/.env.auth. L’exemple pointe uniquement sur le jeu synthétique.
AUTH_ENV=local
AUTH_PROFILE=demo
AUTH_GATEWAY_PORT=5000
AUTH_BACKEND_PORT=5101
AUTH_BACKEND_URL=http://127.0.0.1:5101
AUTH_APP_DATABASE=database/stages_marrakech_public_demo.db
AUTH_DATABASE_URL=sqlite:///auth_gateway/data/auth_users.db
AUTH_ALLOW_REGISTRATION=true
AUTH_SESSION_SECRET=auto
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900

# Laissez vides en mode démo synthétique. N’utilisez jamais de secret de production ici.
AUTH_BACKEND_PASSWORD=
AUTH_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Profil privé local réservé à un seul administrateur de confiance :
# AUTH_PROFILE=private
# AUTH_APP_DATABASE=database/stages_marrakech.db
# AUTH_ALLOW_REGISTRATION=false
# AUTH_DATABASE_URL=sqlite:///auth_gateway/data/auth_private_admin.db
# AUTH_ADMIN_EMAIL=adresse-admin@example.org
# AUTH_BACKEND_PASSWORD=mot-de-passe-actuel-de-l-application
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=mot-de-passe-initial-du-compte-passerelle

# Déploiement public : AUTH_ENV=production, cookie Secure, SECRET géré par l’hébergeur,
# base PostgreSQL persistante et backend privé inaccessible depuis Internet.
