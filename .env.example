# Copier vers .env. Ne jamais versionner ce fichier une fois rempli.
# Le premier lancement demande de créer un mot de passe personnel dans le navigateur.
COOKIE_SECURE=false
DATABASE=database/stages_marrakech.db
PRIVATE_DIR=private
BACKUP_DIR=backups
TRUSTED_HOSTS=127.0.0.1,localhost,[::1]
TRUST_PROXY=false
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_DATA_CONFIRMED=false

# AUCUN service externe n'est activé par défaut.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# À activer uniquement après vérification manuelle du niveau gratuit du projet Cloud.
GEMINI_FREE_TIER_CONFIRMED=false

# Recherche Internet Gemini Search désactivée par défaut.
# L'API Google Search Grounding n'est pas disponible dans le free tier API selon les tarifs officiels.
# Le niveau Standard avec facturation active inclut actuellement 5 000 requêtes de recherche/mois,
# puis 14 USD/1 000 recherches; une invite peut en déclencher plusieurs.
# Ne mettre les deux drapeaux à true qu'après votre propre vérification et autorisation de facturation.
GEMINI_SEARCH_ENABLED=false
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_SEARCH_BILLING_CONFIRMED=false
GEMINI_SEARCH_MAX_SESSION=2
GEMINI_SEARCH_MAX_DAILY=5
GEMINI_SEARCH_COOLDOWN_SECONDS=60
GEMINI_SEARCH_TIMEOUT_MS=30000

# Clé navigateur publique, distincte de la clé serveur Places, restreinte HTTP referrer/API.
MAPS_ENABLED=false
MAPS_BROWSER_KEY=

# Collectes uniquement par commande explicite --allow-external ; pas au démarrage web.
GOOGLE_PLACES_API_KEY=
