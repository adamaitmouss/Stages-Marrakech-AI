# Profil local de démonstration; base synthétique distincte et lecture seule.
COOKIE_SECURE=false
DATABASE=database/stages_marrakech_public_demo.db
PRIVATE_DIR=private
BACKUP_DIR=backups
TRUSTED_HOSTS=127.0.0.1,localhost,[::1]
TRUST_PROXY=false
PUBLIC_DEMO_MODE=true
PUBLIC_DEMO_DATA_CONFIRMED=true
SMTP_ENABLED=false
GEMINI_ENABLED=false
GEMINI_SEARCH_ENABLED=false
MAPS_ENABLED=false
